# ENTSO-E Transparency Platform API token — request via https://transparency.entsoe.eu
ENTSOE_API_TOKEN=

# Base URL of france-electricity-forecasting's serving API
FORECAST_API_URL=http://localhost:8000

# Google AI Studio API key (Gemini, free tier) — https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Phase 1's MCP server (streamable-http)
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
# Must match the port in MCP_SERVER_URL above
MCP_SERVER_PORT=8001

# Langfuse (cloud, free tier) — https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
